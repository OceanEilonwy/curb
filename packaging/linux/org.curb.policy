<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Curb</vendor>
  <vendor_url>https://github.com/OceanEilonwy/curb</vendor_url>

  <action id="org.curb.manage-service">
    <description>Manage Curb firewall service</description>
    <message>Authentication is required to install or uninstall the Curb firewall service.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/curb-cli</annotate>
  </action>
</policyconfig>
