# Optional configuration overrides for curb-relay.service
# Copy to /etc/curb-relay.env and restart: sudo systemctl restart curb-relay

# Listen address and port (put behind Caddy/nginx for TLS in production)
CURB_RELAY_LISTEN=0.0.0.0:8443

# Directory for E2E-encrypted offline settings backups
CURB_RELAY_BACKUP_DIR=/var/lib/curb-relay

# Uncomment to disable encrypted backup storage (100% stateless P2P relay)
# CURB_RELAY_NO_BACKUP=true
