[Unit]
Description=Curb Default-Deny Application Firewall Service
Documentation=https://github.com/OceanEilonwy/curb
After=network-pre.target nftables.service firewalld.service ufw.service
Wants=network-pre.target

[Service]
Type=simple
ExecStart=/usr/libexec/curb/curb-service --data-dir /var/lib/curb
ExecStopPost=-/bin/sh -c 'nft delete table inet curb 2>/dev/null || true'
Restart=on-failure
RestartSec=2
RuntimeDirectory=curb
RuntimeDirectoryMode=0755
StateDirectory=curb
StateDirectoryMode=0755

[Install]
WantedBy=multi-user.target
