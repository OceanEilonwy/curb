import { Theme } from "theme.slint";
import { RemoteAdminItem } from "types.slint";
import { LoadingDots, LockIcon } from "icons.slint";
import { CurbCheckbox, CurbInput, CurbScrollView, CurbSwitch, ReadOnlyStatusPill } from "components.slint";

export component SettingsView inherits CurbScrollView {
    in property <bool> unlocked: false;
    in property <bool> password-configured: true;
    in property <bool> is-full-service: true;
    // 0 = enforcing, 1 = paused_until, 2 = disabled
    in property <int> mode-kind: 0;
    // -1 = none, 0 = enforcing, 1 = paused_until, 2 = disabled
    in property <int> pending-mode: -1;

    in property <bool> baseline-dhcp: true;
    in property <bool> baseline-loopback: true;
    in property <bool> baseline-ntp: true;
    in property <bool> baseline-ncsi: true;
    in property <bool> busy-baseline: false;

    in property <bool> upgrading: false;
    in property <bool> uninstalling: false;

    in-out property <bool> pw-open: false;
    in-out property <string> current-pw: "";
    in-out property <string> new-pw: "";
    in-out property <string> confirm-pw: "";
    in-out property <bool> show-pw: false;
    in property <bool> pw-busy: false;
    in property <string> pw-error: "";

    in property <string> device-name: "This PC";
    in property <[RemoteAdminItem]> remote-admins: [];
    in-out property <string> relay-url: "";
    in property <string> relay-status: "disabled";
    in property <string> relay-error: "";
    in property <bool> encrypted-backup-enabled: true;

    in-out property <bool> adv-open: false;

    callback require-unlock();
    callback upgrade-to-full();
    callback uninstall-service();
    callback toggle-theme();
    callback set-mode(int);
    callback toggle-baseline-dhcp();
    callback toggle-baseline-loopback();
    callback toggle-baseline-ntp();
    callback toggle-baseline-ncsi();
    callback toggle-pw-form();
    callback submit-password-change(string, string, string);
    callback rename-device-clicked();
    callback add-friend-admin-clicked();
    callback connect-friend-clicked();
    callback remove-friend-admin(string);
    callback save-relay-config(string, bool);
    callback retry-relay-connection();

    content-padding: 16px;
    content-spacing: 12px;

    // Protection Tier Status / Upgrade
    Rectangle {
        border-radius: 12px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;

        HorizontalLayout {
            padding: 14px;
            spacing: 10px;
            cross-axis-alignment: center;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;

                Text {
                    text: root.is-full-service ? "Full Protection" : "Standard Mode (No Admin)";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                }
                Text {
                    text: root.is-full-service
                        ? "System firewall active across all adapters"
                        : "Voluntary browser proxy · upgrade anytime";
                    color: Theme.text-sec;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            if root.is-full-service: Rectangle {
                horizontal-stretch: 0;
                height: 24px;
                border-radius: 12px;
                background: Theme.green-soft;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    cross-axis-alignment: center;
                    Text {
                        text: "Active";
                        color: Theme.green-text;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            if !root.is-full-service: Rectangle {
                horizontal-stretch: 0;
                height: 30px;
                border-radius: 8px;
                background: upg-ta.has-hover && !root.upgrading ? Theme.accent-hover : Theme.accent;
                opacity: root.upgrading ? 0.60 : 1.0;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 5px;
                    cross-axis-alignment: center;

                    if root.upgrading: LoadingDots {
                        color: #ffffff;
                        dot-size: 3.5px;
                    }
                    Text {
                        text: root.upgrading ? "Upgrading…" : "Upgrade";
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                upg-ta := TouchArea {
                    enabled: !root.upgrading;
                    mouse-cursor: root.upgrading ? default : pointer;
                    clicked => { root.upgrade-to-full(); }
                }
            }
        }
    }

    // Protection Switch (On / Pause 15m / Off)
    Rectangle {
        border-radius: 12px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            VerticalLayout {
                spacing: 3px;
                Text {
                    text: "Internet Protection";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                }
                Text {
                    text: "Blocks all apps except the ones you’ve allowed";
                    color: Theme.text-sec;
                    font-size: 12px;
                }
            }

            if !root.unlocked: Rectangle {
                height: 36px;
                border-radius: 8px;
                background: locked-mode-ta.has-hover ? Theme.card-hover : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    cross-axis-alignment: center;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.mode-kind == 0
                            ? Theme.green-switch
                            : root.mode-kind == 1
                            ? Theme.amber-solid
                            : Theme.red-solid;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.mode-kind == 0
                            ? "Currently: On"
                            : root.mode-kind == 1
                            ? "Currently: Paused (15m)"
                            : "Currently: Off";
                        color: Theme.text;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        cross-axis-alignment: center;

                        LockIcon {
                            color: Theme.text-muted;
                            size: 10px;
                        }
                        Text {
                            text: "Locked";
                            color: Theme.text-muted;
                            font-size: 11px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }

                locked-mode-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.require-unlock(); }
                }
            }

            if root.unlocked: HorizontalLayout {
                spacing: 8px;

                // On
                Rectangle {
                    horizontal-stretch: 1;
                    height: 34px;
                    border-radius: 8px;
                    background: root.mode-kind == 0 ? Theme.green-solid : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    opacity: root.pending-mode < 0 ? 1.0 : 0.55;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        cross-axis-alignment: center;
                        if root.pending-mode == 0: LoadingDots {
                            color: root.mode-kind == 0 ? #ffffff : Theme.text;
                            dot-size: 3.5px;
                        }
                        Text {
                            text: "On";
                            color: root.mode-kind == 0 ? #ffffff : Theme.text;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        enabled: root.pending-mode < 0;
                        mouse-cursor: root.pending-mode < 0 ? pointer : default;
                        clicked => { root.set-mode(0); }
                    }
                }

                // Pause 15m
                Rectangle {
                    horizontal-stretch: 1;
                    height: 34px;
                    border-radius: 8px;
                    background: root.mode-kind == 1 ? Theme.amber-solid : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    opacity: root.pending-mode < 0 ? 1.0 : 0.55;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        cross-axis-alignment: center;
                        if root.pending-mode == 1: LoadingDots {
                            color: root.mode-kind == 1 ? Theme.amber-on-solid : Theme.text;
                            dot-size: 3.5px;
                        }
                        Text {
                            text: "Pause 15m";
                            color: root.mode-kind == 1 ? Theme.amber-on-solid : Theme.text;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        enabled: root.pending-mode < 0;
                        mouse-cursor: root.pending-mode < 0 ? pointer : default;
                        clicked => { root.set-mode(1); }
                    }
                }

                // Off
                Rectangle {
                    horizontal-stretch: 1;
                    height: 34px;
                    border-radius: 8px;
                    background: root.mode-kind == 2 ? Theme.red-solid : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    opacity: root.pending-mode < 0 ? 1.0 : 0.55;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        cross-axis-alignment: center;
                        if root.pending-mode == 2: LoadingDots {
                            color: root.mode-kind == 2 ? #ffffff : Theme.text;
                            dot-size: 3.5px;
                        }
                        Text {
                            text: "Off";
                            color: root.mode-kind == 2 ? #ffffff : Theme.text;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        enabled: root.pending-mode < 0;
                        mouse-cursor: root.pending-mode < 0 ? pointer : default;
                        clicked => { root.set-mode(2); }
                    }
                }
            }
        }
    }

    // Appearance
    Rectangle {
        border-radius: 12px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;

        HorizontalLayout {
            padding: 14px;
            spacing: 10px;
            cross-axis-alignment: center;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: "Appearance";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                }
                Text {
                    text: "Dark or light theme";
                    color: Theme.text-sec;
                    font-size: 12px;
                }
            }

            Rectangle {
                horizontal-stretch: 0;
                height: 30px;
                border-radius: 8px;
                background: theme-ta.has-hover ? Theme.card-hover : Theme.pill;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    cross-axis-alignment: center;
                    Text {
                        text: Theme.is-dark ? "Switch to Light" : "Switch to Dark";
                        color: Theme.text;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                theme-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-theme(); }
                }
            }
        }
    }

    // Curb Password
    Rectangle {
        border-radius: 12px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 10px;
                cross-axis-alignment: center;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: "Curb Password";
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                    }
                    Text {
                        text: "Protects your rules & pause controls";
                        color: Theme.text-sec;
                        font-size: 12px;
                    }
                }

                Rectangle {
                    horizontal-stretch: 0;
                    height: 30px;
                    border-radius: 8px;
                    background: pw-btn-ta.has-hover && !root.pw-busy ? Theme.card-hover : Theme.pill;
                    opacity: root.pw-busy ? 0.55 : 1.0;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 5px;
                        cross-axis-alignment: center;
                        if !root.unlocked: LockIcon {
                            color: Theme.text-sec;
                            size: 11px;
                        }
                        Text {
                            text: (root.pw-open && root.unlocked) ? "Cancel" : "Change";
                            color: Theme.text;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    pw-btn-ta := TouchArea {
                        enabled: !root.pw-busy;
                        mouse-cursor: root.pw-busy ? default : pointer;
                        clicked => { root.toggle-pw-form(); }
                    }
                }
            }

            if root.pw-open && root.unlocked: VerticalLayout {
                spacing: 10px;

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                if root.password-configured: VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Current password";
                        color: Theme.text-sec;
                        font-size: 12px;
                        font-weight: 500;
                    }
                    CurbInput {
                        text <=> root.current-pw;
                        placeholder: "Enter current password";
                        is-password: !root.show-pw;
                        enabled: !root.pw-busy;
                        accepted => { new-pw-in.focus-input(); }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "New password";
                        color: Theme.text-sec;
                        font-size: 12px;
                        font-weight: 500;
                    }
                    new-pw-in := CurbInput {
                        text <=> root.new-pw;
                        placeholder: "At least 4 characters";
                        is-password: !root.show-pw;
                        enabled: !root.pw-busy;
                        accepted => { confirm-pw-in.focus-input(); }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Confirm new password";
                        color: Theme.text-sec;
                        font-size: 12px;
                        font-weight: 500;
                    }
                    confirm-pw-in := CurbInput {
                        text <=> root.confirm-pw;
                        placeholder: "Re-enter new password";
                        is-password: !root.show-pw;
                        enabled: !root.pw-busy;
                        accepted => {
                            if !root.pw-busy {
                                root.submit-password-change(root.current-pw, root.new-pw, root.confirm-pw);
                            }
                        }
                    }
                }

                if root.pw-error != "": Text {
                    text: root.pw-error;
                    color: Theme.red-text;
                    font-size: 12px;
                    font-weight: 500;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    padding-top: 2px;
                    cross-axis-alignment: center;

                    CurbCheckbox {
                        checked: root.show-pw;
                        enabled: !root.pw-busy;
                        label: "Show passwords";
                        toggled => { root.show-pw = !root.show-pw; }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        horizontal-stretch: 0;
                        height: 30px;
                        border-radius: 8px;
                        background: pw-sub-ta.has-hover && !root.pw-busy ? Theme.accent-hover : Theme.accent;
                        opacity: root.pw-busy ? 0.60 : 1.0;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 5px;
                            cross-axis-alignment: center;
                            if root.pw-busy: LoadingDots {
                                color: #ffffff;
                                dot-size: 3.5px;
                            }
                            Text {
                                text: root.pw-busy ? "Updating…" : "Update Password";
                                color: #ffffff;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        pw-sub-ta := TouchArea {
                            enabled: !root.pw-busy;
                            mouse-cursor: root.pw-busy ? default : pointer;
                            clicked => {
                                root.submit-password-change(root.current-pw, root.new-pw, root.confirm-pw);
                            }
                        }
                    }
                }
            }
        }
    }

    // Device Name (shown in header switcher & synced devices)
    Rectangle {
        border-radius: 12px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;

        HorizontalLayout {
            padding: 14px;
            spacing: 10px;
            cross-axis-alignment: center;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                Text {
                    text: "Device name";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                }
                Text {
                    text: root.device-name;
                    color: Theme.text-sec;
                    font-size: 12px;
                    overflow: elide;
                }
            }

            Rectangle {
                horizontal-stretch: 0;
                height: 30px;
                border-radius: 8px;
                background: rename-ta.has-hover ? Theme.card-hover : Theme.sub;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    cross-axis-alignment: center;
                    Text {
                        text: "Rename";
                        color: Theme.text;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                rename-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.rename-device-clicked(); }
                }
            }
        }
    }

    // Remote Admins & Friends
    Rectangle {
        border-radius: 12px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: "Friend Admins";
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                    }
                    Text {
                        text: "Share a one-time link so a friend can set their own password";
                        color: Theme.text-sec;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                Rectangle {
                    horizontal-stretch: 0;
                    height: 30px;
                    border-radius: 8px;
                    background: add-adm-ta.has-hover ? Theme.accent-hover : Theme.accent;
                    opacity: root.unlocked ? 1.0 : 0.65;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        cross-axis-alignment: center;
                        Text {
                            text: "+ Add friend";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    add-adm-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if root.unlocked {
                                root.add-friend-admin-clicked();
                            } else {
                                root.require-unlock();
                            }
                        }
                    }
                }
            }

            if root.is-full-service && root.relay-status != "disabled": Rectangle {
                border-radius: 8px;
                background: root.relay-status == "connected" ? Theme.green-soft
                    : root.relay-status == "connecting" ? Theme.amber-soft
                    : Theme.red-soft;

                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.relay-status == "connected" ? Theme.green-switch
                                : root.relay-status == "connecting" ? Theme.amber-solid
                                : Theme.red-solid;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: root.relay-status == "connected" ? "Connected to sync relay"
                                : root.relay-status == "connecting" ? "Connecting to sync relay…"
                                : "Not connected to sync relay";
                            color: root.relay-status == "connected" ? Theme.green-text
                                : root.relay-status == "connecting" ? Theme.amber-text
                                : Theme.red-text;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        if root.relay-status != "connected": Rectangle {
                            horizontal-stretch: 0;
                            height: 24px;
                            border-radius: 6px;
                            background: friend-retry-ta.has-hover ? Theme.card-hover : Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                cross-axis-alignment: center;
                                Text {
                                    text: root.relay-status == "connecting" ? "Retrying…" : "Retry";
                                    color: Theme.text;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            friend-retry-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.retry-relay-connection(); }
                            }
                        }
                    }

                    if root.relay-status == "disconnected" && root.relay-error != "": Text {
                        text: root.relay-error;
                        color: Theme.red-text;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }

            if root.remote-admins.length > 0: VerticalLayout {
                spacing: 6px;

                for adm in root.remote-admins: HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;

                    Text {
                        horizontal-stretch: 1;
                        text: adm.name;
                        color: Theme.text;
                        font-size: 12.5px;
                        font-weight: 500;
                        overflow: elide;
                    }

                    if root.unlocked: Rectangle {
                        horizontal-stretch: 0;
                        height: 24px;
                        border-radius: 6px;
                        background: Theme.red-soft;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;
                            Text {
                                text: "Remove";
                                color: Theme.red-text;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.remove-friend-admin(adm.id); }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;

                Text {
                    horizontal-stretch: 1;
                    text: "Have an invite link from a friend?";
                    color: Theme.text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 0;
                    height: 28px;
                    border-radius: 8px;
                    background: conn-fr-ta.has-hover ? Theme.card-hover : Theme.sub;
                    border-width: 1px;
                    border-color: Theme.border;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        cross-axis-alignment: center;
                        Text {
                            text: "Connect";
                            color: Theme.text;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    conn-fr-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.connect-friend-clicked(); }
                    }
                }
            }
        }
    }

    // Collapsible Advanced Settings
    Rectangle {
        border-radius: 12px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        VerticalLayout {
            Rectangle {
                height: 38px;
                background: transparent;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    cross-axis-alignment: center;

                    Text {
                        horizontal-stretch: 1;
                        text: "Advanced Settings";
                        color: Theme.text;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.adv-open ? "Hide" : "Show";
                        color: Theme.text-sec;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.adv-open = !root.adv-open; }
                }
            }

            if root.adv-open: Rectangle {
                background: Theme.surface;

                Rectangle {
                    y: 0;
                    width: 100%;
                    height: 1px;
                    background: Theme.border;
                }

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    Text {
                        text: "Windows System Essentials (WFP Baseline)";
                        color: Theme.text-sec;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    // DHCP
                    HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: "DHCP"; color: Theme.text; font-size: 12px; font-weight: 600; }
                            Text { text: "Wi-Fi & Ethernet IP assignment"; color: Theme.text-muted; font-size: 12px; }
                        }
                        if root.unlocked: CurbSwitch {
                            checked: root.baseline-dhcp;
                            enabled: !root.busy-baseline;
                            toggled => { root.toggle-baseline-dhcp(); }
                        }
                        if !root.unlocked: ReadOnlyStatusPill {
                            active: root.baseline-dhcp;
                            clicked => { root.require-unlock(); }
                        }
                    }

                    // Loopback
                    HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: "Loopback"; color: Theme.text; font-size: 12px; font-weight: 600; }
                            Text { text: "127.0.0.1 / ::1 local app IPC"; color: Theme.text-muted; font-size: 12px; }
                        }
                        if root.unlocked: CurbSwitch {
                            checked: root.baseline-loopback;
                            enabled: !root.busy-baseline;
                            toggled => { root.toggle-baseline-loopback(); }
                        }
                        if !root.unlocked: ReadOnlyStatusPill {
                            active: root.baseline-loopback;
                            clicked => { root.require-unlock(); }
                        }
                    }

                    // NTP
                    HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: "NTP Time Sync"; color: Theme.text; font-size: 12px; font-weight: 600; }
                            Text { text: "Clock accuracy for HTTPS certificates"; color: Theme.text-muted; font-size: 12px; }
                        }
                        if root.unlocked: CurbSwitch {
                            checked: root.baseline-ntp;
                            enabled: !root.busy-baseline;
                            toggled => { root.toggle-baseline-ntp(); }
                        }
                        if !root.unlocked: ReadOnlyStatusPill {
                            active: root.baseline-ntp;
                            clicked => { root.require-unlock(); }
                        }
                    }

                    // NCSI
                    HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: "Windows NCSI"; color: Theme.text; font-size: 12px; font-weight: 600; }
                            Text { text: "Prevents false “No Internet” icon"; color: Theme.text-muted; font-size: 12px; }
                        }
                        if root.unlocked: CurbSwitch {
                            checked: root.baseline-ncsi;
                            enabled: !root.busy-baseline;
                            toggled => { root.toggle-baseline-ncsi(); }
                        }
                        if !root.unlocked: ReadOnlyStatusPill {
                            active: root.baseline-ncsi;
                            clicked => { root.require-unlock(); }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border; }

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Firewall: Windows Filtering Platform (IPv4/IPv6)";
                            color: Theme.text-muted;
                            font-size: 11px;
                            font-family: "JetBrains Mono";
                        }
                        Text {
                            text: "Adapter DNS: 127.0.0.1 (auto-restored when off)";
                            color: Theme.text-muted;
                            font-size: 11px;
                            font-family: "JetBrains Mono";
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border; }

                    VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Text {
                                horizontal-stretch: 1;
                                text: "Sync Relay (P2P Proxy)";
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 0;
                                height: 22px;
                                border-radius: 11px;
                                background: root.relay-status == "connected" ? Theme.green-soft
                                    : root.relay-status == "connecting" ? Theme.amber-soft
                                    : root.relay-status == "disconnected" ? Theme.red-soft
                                    : Theme.pill;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 5px;
                                    cross-axis-alignment: center;

                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: root.relay-status == "connected" ? Theme.green-switch
                                            : root.relay-status == "connecting" ? Theme.amber-solid
                                            : root.relay-status == "disconnected" ? Theme.red-solid
                                            : Theme.text-muted;
                                    }

                                    Text {
                                        text: root.relay-status == "connected" ? "Connected"
                                            : root.relay-status == "connecting" ? "Connecting…"
                                            : root.relay-status == "disconnected" ? "Disconnected"
                                            : "Off";
                                        color: root.relay-status == "connected" ? Theme.green-text
                                            : root.relay-status == "connecting" ? Theme.amber-text
                                            : root.relay-status == "disconnected" ? Theme.red-text
                                            : Theme.text-muted;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if root.relay-status != "disabled": Rectangle {
                                horizontal-stretch: 0;
                                height: 22px;
                                border-radius: 6px;
                                background: adv-retry-ta.has-hover ? Theme.card-hover : Theme.sub;
                                border-width: 1px;
                                border-color: Theme.border;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    cross-axis-alignment: center;
                                    Text {
                                        text: "Retry";
                                        color: Theme.text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                adv-retry-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.retry-relay-connection(); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            cross-axis-alignment: center;

                            CurbInput {
                                horizontal-stretch: 1;
                                text <=> root.relay-url;
                                placeholder: "http://your-relay:8443 or https://relay.curb.app";
                                enabled: root.unlocked;
                            }

                            Rectangle {
                                horizontal-stretch: 0;
                                height: 32px;
                                border-radius: 8px;
                                background: save-relay-ta.has-hover && root.unlocked ? Theme.accent-hover : Theme.accent;
                                opacity: root.unlocked ? 1.0 : 0.55;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    cross-axis-alignment: center;
                                    Text {
                                        text: "Save";
                                        color: #ffffff;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                save-relay-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if root.unlocked {
                                            root.save-relay-config(root.relay-url, root.encrypted-backup-enabled);
                                        } else {
                                            root.require-unlock();
                                        }
                                    }
                                }
                            }
                        }

                        if root.relay-status == "disconnected" && root.relay-error != "": Text {
                            text: root.relay-error;
                            color: Theme.red-text;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Text {
                                horizontal-stretch: 1;
                                text: "Encrypted offline backup";
                                color: Theme.text-sec;
                                font-size: 12px;
                            }

                            if root.unlocked: CurbSwitch {
                                checked: root.encrypted-backup-enabled;
                                toggled => {
                                    root.save-relay-config(root.relay-url, !root.encrypted-backup-enabled);
                                }
                            }
                            if !root.unlocked: ReadOnlyStatusPill {
                                active: root.encrypted-backup-enabled;
                                clicked => { root.require-unlock(); }
                            }
                        }
                    }

                    if root.is-full-service: VerticalLayout {
                        spacing: 10px;
                        Rectangle { height: 1px; background: Theme.border; }

                        HorizontalLayout {
                            spacing: 10px;
                            cross-axis-alignment: center;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: "Remove System Service";
                                    color: Theme.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "Stops and unregisters CurbService (Admin prompt)";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }

                            if !root.unlocked: Rectangle {
                                horizontal-stretch: 0;
                                height: 28px;
                                border-radius: 8px;
                                background: locked-rm-ta.has-hover ? Theme.card-hover : Theme.sub;
                                border-width: 1px;
                                border-color: Theme.border;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 5px;
                                    cross-axis-alignment: center;
                                    LockIcon {
                                        color: Theme.text-muted;
                                        size: 11px;
                                    }
                                    Text {
                                        text: "Locked";
                                        color: Theme.text-muted;
                                        font-size: 11.5px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                locked-rm-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.require-unlock(); }
                                }
                            }

                            if root.unlocked: Rectangle {
                                horizontal-stretch: 0;
                                height: 28px;
                                border-radius: 8px;
                                background: Theme.red-soft;
                                opacity: !root.uninstalling ? 1.0 : 0.55;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 5px;
                                    cross-axis-alignment: center;
                                    if root.uninstalling: LoadingDots {
                                        color: Theme.red-text;
                                        dot-size: 3.5px;
                                    }
                                    Text {
                                        text: root.uninstalling ? "Removing…" : "Remove";
                                        color: Theme.red-text;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchArea {
                                    enabled: !root.uninstalling;
                                    mouse-cursor: !root.uninstalling ? pointer : default;
                                    clicked => { root.uninstall-service(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
