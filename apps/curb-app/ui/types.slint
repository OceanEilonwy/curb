export struct RuleItem {
    id: string,
    name: string,
    icon: image,
    has-icon: bool,
    initials: string,
    avatar-color: color,
    enabled: bool,
    signed: bool,
    is-steam-game: bool,
    allow-helpers: bool,
    allow-tcp: bool,
    allow-udp: bool,
    // 0 = disabled, 1 = same_signer_or_dir, 2 = any_except_restricted
    subprocess-policy: int,
    dns-whitelist: [string],
    exe-hint: string,
    matcher-detail: string,
    expanded: bool,
    adv-open: bool,
    busy: bool,
    deleting: bool,
    // Playtime & first-class match-aware fields
    first-class: bool,
    detector-name: string,
    playtime-enabled: bool,
    playtime-active: bool,
    // 0 = Playing, 1 = Finishing Match, 2 = Overtime
    playtime-chip-state: int,
    playtime-sub-meta: string,
    playtime-remaining-pct: float,
    // 0 = Daily, 1 = Weekly, 2 = Custom
    playtime-budget-mode: int,
    playtime-daily-hours: string,
    playtime-weekly-hours: string,
    playtime-custom-expr: string,
    playtime-custom-summary: string,
    playtime-custom-error: bool,
    playtime-wait-match: bool,
    playtime-used-label: string,
    playtime-live-telemetry: string,
}

export struct BlockedEventItem {
    id: string,
    app-name: string,
    icon: image,
    has-icon: bool,
    initials: string,
    avatar-color: color,
    relative-time: string,
    destination: string,
    is-steam-community: bool,
    allowing: bool,
}

export struct RunningAppItem {
    key: string,
    name: string,
    icon: image,
    has-icon: bool,
    initials: string,
    avatar-color: color,
    exe: string,
    path: string,
    process-count: int,
    background: bool,
    tried-connect: bool,
    tried-host: string,
    signed: bool,
    already-allowed: bool,
    selected: bool,
}

export struct SteamGameItem {
    key: string,
    app-id: int,
    name: string,
    icon: image,
    has-icon: bool,
    initials: string,
    avatar-color: color,
    exe-name: string,
    exe-path: string,
    signed: bool,
    already-allowed: bool,
    selected: bool,
}

export struct RemoteDeviceItem {
    id: string,
    name: string,
    is-remote: bool,
    selected: bool,
    online: bool,
    status-label: string,
}

export struct RemoteAdminItem {
    id: string,
    name: string,
}
