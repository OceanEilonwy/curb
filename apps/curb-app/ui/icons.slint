// Crisp vector icons compatible with Slint's software renderer (no rotation transforms).

export component CheckIcon inherits Path {
    in property <color> color: #ffffff;
    in property <length> size: 13px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    stroke-width: 2.6px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    commands: "M 20 6 L 9 17 L 4 12";
}

