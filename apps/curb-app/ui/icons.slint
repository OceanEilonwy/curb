export component LoadingDots inherits HorizontalLayout {
    in property <color> color: #cfd4dc;
    in property <length> dot-size: 4px;
    spacing: 3px;
    alignment: center;
    cross-axis-alignment: center;

    property <int> phase: mod(floor(animation-tick() / 220ms), 3);

    Rectangle {
        width: root.dot-size;
        height: root.dot-size;
        border-radius: root.dot-size / 2;
        background: root.color;
        opacity: root.phase == 0 ? 1.0 : 0.35;
    }
    Rectangle {
        width: root.dot-size;
        height: root.dot-size;
        border-radius: root.dot-size / 2;
        background: root.color;
        opacity: root.phase == 1 ? 1.0 : 0.35;
    }
    Rectangle {
        width: root.dot-size;
        height: root.dot-size;
        border-radius: root.dot-size / 2;
        background: root.color;
        opacity: root.phase == 2 ? 1.0 : 0.35;
    }
}
