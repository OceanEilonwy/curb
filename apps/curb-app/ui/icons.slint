export component ShieldIcon inherits Path {
    // 0 = on (check), 1 = paused (bars), 2 = off (cross)
    in property <int> mode: 0;
    in property <color> color: #74eea6;
    in property <length> size: 15px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    stroke-width: 2.3px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    commands: mode == 0
        ? "M 12 22 C 12 22 20 18 20 12 L 20 5 L 12 2 L 4 5 L 4 12 C 4 18 12 22 12 22 Z M 9 12 L 11 14 L 15 10"
        : mode == 1
        ? "M 12 22 C 12 22 20 18 20 12 L 20 5 L 12 2 L 4 5 L 4 12 C 4 18 12 22 12 22 Z M 10 9 L 10 15 M 14 9 L 14 15"
        : "M 12 22 C 12 22 20 18 20 12 L 20 5 L 12 2 L 4 5 L 4 12 C 4 18 12 22 12 22 Z M 9 9 L 15 15 M 15 9 L 9 15";
}

export component ChevronIcon inherits Path {
    in property <bool> rotated: false;
    in property <color> color: #cfd4dc;
    in property <length> size: 15px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    stroke-width: 2.2px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    commands: rotated ? "M 6 15 L 12 9 L 18 15" : "M 6 9 L 12 15 L 18 9";
}

