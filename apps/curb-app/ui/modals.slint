import { Theme } from "theme.slint";
import { LoadingDots } from "icons.slint";
import { CurbInput } from "components.slint";

export component UnlockModal inherits Rectangle {
    in property <bool> password-configured: true;
    in-out property <string> password: "";
    in-out property <string> confirm-password: "";
    in property <string> error-text: "";
    in property <bool> busy: false;

    callback close();
    callback submit(string, string);

    public function focus-field() {
        pw-in.focus-input();
    }

    background: Theme.scrim;

    // Eat background clicks
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            if !root.busy {
                root.close();
            }
        }
    }

    Rectangle {
        width: 330px;
        height: dialog-layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 12px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: rgba(0, 0, 0, 0.45);

        // Stop propagation to scrim
        TouchArea {
            width: 100%;
            height: 100%;
        }

        dialog-layout := VerticalLayout {
            padding: 16px;
            spacing: 12px;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: root.password-configured ? "Enter Curb Password" : "Set Curb Admin Password";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                }
                Text {
                    text: root.password-configured
                        ? "Needed to change allowed apps or pause protection."
                        : "Choose a password to protect your rules and pause controls.";
                    color: Theme.text-sec;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                spacing: 8px;

                pw-in := CurbInput {
                    text <=> root.password;
                    fill-color: Theme.sub;
                    is-password: true;
                    enabled: !root.busy;
                    placeholder: root.password-configured ? "Password" : "New password (min 4 characters)";
                    accepted => {
                        if !root.busy {
                            root.submit(root.password, root.confirm-password);
                        }
                    }
                }

                if !root.password-configured: confirm-in := CurbInput {
                    text <=> root.confirm-password;
                    fill-color: Theme.sub;
                    is-password: true;
                    enabled: !root.busy;
                    placeholder: "Confirm password";
                    accepted => {
                        if !root.busy {
                            root.submit(root.password, root.confirm-password);
                        }
                    }
                }

                if root.error-text != "": Text {
                    text: root.error-text;
                    color: Theme.red-text;
                    font-size: 12px;
                    font-weight: 500;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Rectangle {
                    height: 30px;
                    border-radius: 8px;
                    background: cancel-ta.has-hover && !root.busy ? Theme.card : transparent;
                    opacity: root.busy ? 0.55 : 1.0;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        cross-axis-alignment: center;
                        Text {
                            text: "Cancel";
                            color: Theme.text-sec;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    cancel-ta := TouchArea {
                        enabled: !root.busy;
                        mouse-cursor: root.busy ? default : pointer;
                        clicked => { root.close(); }
                    }
                }

                Rectangle {
                    height: 30px;
                    border-radius: 8px;
                    background: ok-ta.has-hover && !root.busy ? Theme.accent-hover : Theme.accent;
                    opacity: root.busy ? 0.60 : 1.0;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 6px;
                        cross-axis-alignment: center;

                        if root.busy: LoadingDots {
                            color: #ffffff;
                            dot-size: 3.5px;
                        }

                        Text {
                            text: root.busy
                                ? "Checking…"
                                : root.password-configured ? "Unlock" : "Set Password";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    ok-ta := TouchArea {
                        enabled: !root.busy;
                        mouse-cursor: root.busy ? default : pointer;
                        clicked => { root.submit(root.password, root.confirm-password); }
                    }
                }
            }
        }
    }
}

export component PromptModal inherits Rectangle {
    in property <string> title: "";
    in property <string> description: "";
    in property <string> placeholder: "";
    in property <string> submit-label: "OK";
    in property <string> busy-label: "Saving…";
    in property <bool> mono: true;
    in-out property <string> value: "";
    in property <string> error-text: "";
    in property <bool> busy: false;

    callback close();
    callback submit(string);

    public function focus-field() {
        val-in.focus-input();
    }

    background: Theme.scrim;

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            if !root.busy {
                root.close();
            }
        }
    }

    Rectangle {
        width: 360px;
        height: dialog-layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 12px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: rgba(0, 0, 0, 0.45);

        TouchArea {
            width: 100%;
            height: 100%;
        }

        dialog-layout := VerticalLayout {
            padding: 16px;
            spacing: 12px;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                }
                if root.description != "": Text {
                    text: root.description;
                    color: Theme.text-sec;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                spacing: 8px;

                val-in := CurbInput {
                    text <=> root.value;
                    fill-color: Theme.sub;
                    mono: root.mono;
                    enabled: !root.busy;
                    placeholder: root.placeholder;
                    accepted => {
                        if !root.busy {
                            root.submit(root.value);
                        }
                    }
                }

                if root.error-text != "": Text {
                    text: root.error-text;
                    color: Theme.red-text;
                    font-size: 12px;
                    font-weight: 500;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Rectangle {
                    height: 30px;
                    border-radius: 8px;
                    background: cancel-ta.has-hover && !root.busy ? Theme.card : transparent;
                    opacity: root.busy ? 0.55 : 1.0;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        cross-axis-alignment: center;
                        Text {
                            text: "Cancel";
                            color: Theme.text-sec;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    cancel-ta := TouchArea {
                        enabled: !root.busy;
                        mouse-cursor: root.busy ? default : pointer;
                        clicked => { root.close(); }
                    }
                }

                Rectangle {
                    height: 30px;
                    border-radius: 8px;
                    background: ok-ta.has-hover && !root.busy ? Theme.accent-hover : Theme.accent;
                    opacity: root.busy ? 0.60 : 1.0;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 6px;
                        cross-axis-alignment: center;

                        if root.busy: LoadingDots {
                            color: #ffffff;
                            dot-size: 3.5px;
                        }

                        Text {
                            text: root.busy ? root.busy-label : root.submit-label;
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    ok-ta := TouchArea {
                        enabled: !root.busy;
                        mouse-cursor: root.busy ? default : pointer;
                        clicked => { root.submit(root.value); }
                    }
                }
            }
        }
    }
}

export component ToastBanner inherits Rectangle {
    in property <string> message: "";
    in property <length> max-toast-width: 440px;

    height: 32px;
    width: min(root.max-toast-width, toast-layout.preferred-width);
    border-radius: 8px;
    background: Theme.sub;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: rgba(0, 0, 0, 0.45);

    toast-layout := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        cross-axis-alignment: center;

        Text {
            text: root.message;
            color: Theme.text;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
