import { Theme } from "theme.slint";
import { RuleItem } from "types.slint";
import { CheckIcon, ChevronIcon, LoadingDots, WarnIcon } from "icons.slint";
import { AppIconBadge, CurbScrollView, CurbSwitch, DomainChip, ReadOnlyStatusPill, SubprocessSelector } from "components.slint";

export component AllowedView inherits CurbScrollView {
    in property <bool> unlocked: false;

    // Built-in Steam preset
    in property <image> steam-icon;
    in property <bool> steam-has-icon: false;
    in property <bool> steam-enabled: true;
    in property <bool> steam-store: true;
    in property <bool> steam-community: false;
    in property <bool> steam-friends: false;
    in property <string> steam-summary: "Downloads · Store";
    in property <[string]> steam-domains: [];
    in property <bool> steam-expanded: true;
    in property <bool> steam-adv-open: false;
    in property <bool> busy-steam: false;

    // User rules
    in property <[RuleItem]> rules: [];
    in property <bool> playtime-limits-enabled: true;
    in property <bool> has-any-playtime-limits: false;

    callback require-unlock();
    callback toggle-steam-expand();
    callback toggle-steam-adv();
    callback toggle-steam-enabled();
    callback toggle-steam-store();
    callback toggle-steam-community();
    callback toggle-steam-friends();
    callback toggle-global-playtime-limits();
    callback reset-all-playtime-limits();

    callback toggle-rule-expand(string);
    callback toggle-rule-adv(string);
    callback toggle-rule-enabled(string);
    callback toggle-rule-helpers(string);
    callback toggle-rule-tcp(string);
    callback toggle-rule-udp(string);
    callback set-rule-subprocesses(string, int);
    callback open-add-domain(string);
    callback remove-rule-domain(string, int);
    callback delete-rule(string);
    callback toggle-rule-playtime(string);
    callback set-rule-playtime-mode(string, int);
    callback set-rule-playtime-daily(string, string);
    callback set-rule-playtime-weekly(string, string);
    callback set-rule-playtime-custom(string, string);
    callback toggle-rule-playtime-wait-match(string);
    callback reset-rule-playtime(string);

    content-padding: 16px;
    content-spacing: 12px;

    Text {
        text: "Everything on this computer is offline unless it’s turned on below.";
        color: Theme.text-sec;
        font-size: 12px;
        wrap: word-wrap;
    }

    // Global Playtime Limits Admin Bar (shown when any game has a playtime limit)
    if root.has-any-playtime-limits: Rectangle {
        border-radius: 12px;
        background: Theme.bg;
        border-width: 1px;
        border-color: Theme.border;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 12px;
            padding-top: 9px;
            padding-bottom: 9px;
            spacing: 10px;
            cross-axis-alignment: center;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    cross-axis-alignment: center;

                    Text {
                        text: "Playtime limits";
                        color: Theme.text;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    if !root.playtime-limits-enabled: Rectangle {
                        height: 17px;
                        border-radius: 8.5px;
                        background: Theme.amber-soft;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            cross-axis-alignment: center;
                            Text {
                                text: "Disabled";
                                color: Theme.amber-text;
                                font-size: 10px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: root.playtime-limits-enabled
                        ? "Enforcing daily & match-aware limits"
                        : "All game playtime limits are temporarily off";
                    color: Theme.text-muted;
                    font-size: 11px;
                    overflow: elide;
                }
            }

            if root.unlocked: Rectangle {
                background: transparent;
                height: 22px;
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    cross-axis-alignment: center;
                    Text {
                        text: "Reset all";
                        color: Theme.accent-text;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.reset-all-playtime-limits(); }
                }
            }

            if root.unlocked: CurbSwitch {
                checked: root.playtime-limits-enabled;
                toggled => { root.toggle-global-playtime-limits(); }
            }
            if !root.unlocked: ReadOnlyStatusPill {
                active: root.playtime-limits-enabled;
                active-label: "Active";
                inactive-label: "Off";
                clicked => { root.require-unlock(); }
            }
        }
    }

    // Built-in Steam Preset Card
    Rectangle {
        border-radius: 12px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        VerticalLayout {
            // Card Header
            Rectangle {
                background: transparent;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;
                    cross-axis-alignment: center;

                    // Clickable left title region
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        HorizontalLayout {
                            spacing: 10px;
                            cross-axis-alignment: center;

                            AppIconBadge {
                                icon: root.steam-icon;
                                has-icon: root.steam-has-icon;
                                initials: "ST";
                                avatar-color: #1b2838;
                                size: 28px;
                                corner-radius: 7px;
                                font-size: 11px;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: "Steam";
                                        color: Theme.text;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        height: 19px;
                                        border-radius: 9.5px;
                                        background: Theme.accent-soft;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: "Built-in";
                                                color: Theme.accent-text;
                                                font-size: 11px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: root.steam-summary;
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.toggle-steam-expand(); }
                        }
                    }

                    if root.unlocked: CurbSwitch {
                        checked: root.steam-enabled;
                        enabled: !root.busy-steam;
                        toggled => { root.toggle-steam-enabled(); }
                    }
                    if !root.unlocked: ReadOnlyStatusPill {
                        active: root.steam-enabled;
                        clicked => { root.require-unlock(); }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: steam-chev-ta.has-hover ? Theme.card-hover : transparent;

                        ChevronIcon {
                            rotated: root.steam-expanded;
                            color: Theme.text-sec;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        steam-chev-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-steam-expand(); }
                        }
                    }
                }
            }

            // Expanded Steam options
            if root.steam-expanded: Rectangle {
                background: Theme.surface;

                Rectangle {
                    y: 0;
                    width: 100%;
                    height: 1px;
                    background: Theme.border;
                }

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 12px;

                    // Store & Library
                    HorizontalLayout {
                        spacing: 12px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Store & Library";
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Browse store & download games (blocks external links)";
                                color: Theme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                        if root.unlocked: CurbSwitch {
                            checked: root.steam-store;
                            enabled: !root.busy-steam;
                            toggled => { root.toggle-steam-store(); }
                        }
                        if !root.unlocked: ReadOnlyStatusPill {
                            active: root.steam-store;
                            clicked => { root.require-unlock(); }
                        }
                    }

                    // Community & Workshop
                    HorizontalLayout {
                        spacing: 12px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Community & Workshop";
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Mods, guides, and forums";
                                color: Theme.text-muted;
                                font-size: 12px;
                            }
                        }
                        if root.unlocked: CurbSwitch {
                            checked: root.steam-community;
                            enabled: !root.busy-steam;
                            toggled => { root.toggle-steam-community(); }
                        }
                        if !root.unlocked: ReadOnlyStatusPill {
                            active: root.steam-community;
                            clicked => { root.require-unlock(); }
                        }
                    }

                    // Friends & Voice
                    HorizontalLayout {
                        spacing: 12px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: "Friends & Voice";
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Chat and voice with Steam friends";
                                color: Theme.text-muted;
                                font-size: 12px;
                            }
                        }
                        if root.unlocked: CurbSwitch {
                            checked: root.steam-friends;
                            enabled: !root.busy-steam;
                            toggled => { root.toggle-steam-friends(); }
                        }
                        if !root.unlocked: ReadOnlyStatusPill {
                            active: root.steam-friends;
                            clicked => { root.require-unlock(); }
                        }
                    }

                    // Divider + Advanced toggle
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    Rectangle {
                        background: transparent;
                        height: 22px;

                        HorizontalLayout {
                            cross-axis-alignment: center;
                            Text {
                                horizontal-stretch: 1;
                                text: "Advanced";
                                color: Theme.text-sec;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.steam-adv-open ? "Hide" : "Show";
                                color: Theme.text-sec;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.toggle-steam-adv(); }
                        }
                    }

                    if root.steam-adv-open: Rectangle {
                        border-radius: 8px;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.border-strong;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            Text {
                                text: "steam.exe, steamservice.exe (Valve Corp. · TCP/UDP)";
                                color: Theme.text-sec;
                                font-size: 11px;
                                font-family: "JetBrains Mono";
                                wrap: word-wrap;
                            }

                            Text {
                                text: "steamwebhelper.exe DNS whitelist:";
                                color: Theme.text-muted;
                                font-size: 11px;
                                font-family: "JetBrains Mono";
                            }

                            FlexboxLayout {
                                flex-wrap: wrap;
                                spacing: 6px;

                                for dom in root.steam-domains: DomainChip {
                                    domain: dom;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // User Allowed Rules
    VerticalLayout {
        spacing: 8px;

        for rule in root.rules: Rectangle {
            border-radius: 12px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            VerticalLayout {
                // Rule Header
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;
                    cross-axis-alignment: center;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        HorizontalLayout {
                            spacing: 10px;
                            cross-axis-alignment: center;

                            AppIconBadge {
                                icon: rule.icon;
                                has-icon: rule.has-icon;
                                initials: rule.initials;
                                avatar-color: rule.avatar-color;
                                size: 28px;
                                corner-radius: 7px;
                                font-size: 11px;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: rule.name;
                                        color: Theme.text;
                                        font-size: 13px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }

                                    if rule.first-class: Rectangle {
                                        height: 17px;
                                        border-radius: 8.5px;
                                        background: Theme.accent-soft;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: "✦ Match-aware";
                                                color: Theme.accent-text;
                                                font-size: 10px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                if rule.playtime-enabled: HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    cross-axis-alignment: center;

                                    Rectangle {
                                        height: 18px;
                                        border-radius: 9px;
                                        background: !rule.playtime-active || rule.playtime-chip-state == 0
                                            ? Theme.green-soft
                                            : rule.playtime-chip-state == 1
                                                ? Theme.amber-soft
                                                : Theme.red-soft;
                                        HorizontalLayout {
                                            padding-left: 7px;
                                            padding-right: 7px;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: !rule.playtime-active || rule.playtime-chip-state == 0
                                                    ? "Playing"
                                                    : rule.playtime-chip-state == 1
                                                        ? "Finishing Match"
                                                        : "Overtime";
                                                color: !rule.playtime-active || rule.playtime-chip-state == 0
                                                    ? Theme.green-text
                                                    : rule.playtime-chip-state == 1
                                                        ? Theme.amber-text
                                                        : Theme.red-text;
                                                font-size: 11px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Text {
                                        text: rule.playtime-sub-meta;
                                        color: rule.playtime-active && rule.playtime-chip-state == 2
                                            ? Theme.red-text
                                            : rule.playtime-active && rule.playtime-chip-state == 1
                                                ? Theme.amber-text
                                                : Theme.text-sec;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }

                                if !rule.playtime-enabled: HorizontalLayout {
                                    spacing: 5px;
                                    alignment: start;
                                    cross-axis-alignment: center;

                                    if rule.signed: CheckIcon {
                                        color: Theme.green-text;
                                        size: 12px;
                                    }
                                    if !rule.signed: WarnIcon {
                                        color: Theme.amber-text;
                                        size: 12px;
                                    }
                                    Text {
                                        text: rule.signed ? "Updates automatically" : "Needs re-approval after updates";
                                        color: rule.signed ? Theme.green-text : Theme.amber-text;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.toggle-rule-expand(rule.id); }
                        }
                    }

                    if root.unlocked: CurbSwitch {
                        checked: rule.enabled;
                        enabled: !rule.busy;
                        toggled => { root.toggle-rule-enabled(rule.id); }
                    }
                    if !root.unlocked: ReadOnlyStatusPill {
                        active: rule.enabled;
                        clicked => { root.require-unlock(); }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: rule-chev-ta.has-hover ? Theme.card-hover : transparent;

                        ChevronIcon {
                            rotated: rule.expanded;
                            color: Theme.text-sec;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        rule-chev-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-rule-expand(rule.id); }
                        }
                    }
                }

                // Full-width edge-to-edge daily remaining progress bar
                if rule.playtime-active: Rectangle {
                    width: 100%;
                    height: 5px;
                    background: Theme.sub;

                    Rectangle {
                        x: 0;
                        y: 0;
                        height: 100%;
                        width: rule.playtime-chip-state == 1
                            ? parent.width
                            : parent.width * Math.clamp(rule.playtime-remaining-pct, 0.0, 1.0);
                        background: rule.playtime-chip-state == 0
                            ? Theme.green-switch
                            : rule.playtime-chip-state == 1
                                ? Theme.amber-solid
                                : Theme.red-solid;
                    }
                }

                // Expanded Rule Body
                if rule.expanded: Rectangle {
                    background: Theme.surface;

                    Rectangle {
                        y: 0;
                        width: 100%;
                        height: 1px;
                        background: Theme.border;
                    }

                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 10px;

                        // Steam Playtime Limit Section
                        if rule.is-steam-game: VerticalLayout {
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 12px;
                                cross-axis-alignment: center;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "Playtime limit";
                                        color: Theme.text;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "Cuts internet access when budget runs out · debt carries over";
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                }

                                if root.unlocked: CurbSwitch {
                                    checked: rule.playtime-enabled;
                                    enabled: !rule.busy;
                                    toggled => { root.toggle-rule-playtime(rule.id); }
                                }
                                if !root.unlocked: ReadOnlyStatusPill {
                                    active: rule.playtime-enabled;
                                    clicked => { root.require-unlock(); }
                                }
                            }

                            if rule.playtime-enabled: Rectangle {
                                border-radius: 8px;
                                background: Theme.card;
                                border-width: 1px;
                                border-color: Theme.border;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 8px;

                                    // Budget Mode Selector: Daily / Weekly / Custom
                                    HorizontalLayout {
                                        cross-axis-alignment: center;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: "Budget";
                                            color: Theme.text-sec;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }

                                        HorizontalLayout {
                                            spacing: 4px;

                                            for mode-item in [
                                                { idx: 0, label: "Daily" },
                                                { idx: 1, label: "Weekly" },
                                                { idx: 2, label: "Custom" },
                                            ]: Rectangle {
                                                height: 22px;
                                                border-radius: 5px;
                                                background: rule.playtime-budget-mode == mode-item.idx ? Theme.accent : Theme.pill;
                                                opacity: root.unlocked && !rule.busy ? 1.0 : 0.65;

                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    cross-axis-alignment: center;
                                                    Text {
                                                        text: mode-item.label;
                                                        color: rule.playtime-budget-mode == mode-item.idx ? #ffffff : Theme.text;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                TouchArea {
                                                    enabled: root.unlocked && !rule.busy;
                                                    mouse-cursor: root.unlocked && !rule.busy ? pointer : default;
                                                    clicked => { root.set-rule-playtime-mode(rule.id, mode-item.idx); }
                                                }
                                            }
                                        }
                                    }

                                    // Daily Hours Input (compact width)
                                    if rule.playtime-budget-mode == 0: HorizontalLayout {
                                        cross-axis-alignment: center;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: "Daily";
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            cross-axis-alignment: center;
                                            Rectangle {
                                                width: 54px;
                                                height: 26px;
                                                border-radius: 5px;
                                                background: Theme.bg;
                                                border-width: 1px;
                                                border-color: Theme.border-strong;

                                                daily-in := TextInput {
                                                    text: rule.playtime-daily-hours;
                                                    enabled: root.unlocked && !rule.busy;
                                                    color: Theme.text;
                                                    font-size: 12px;
                                                    font-family: "JetBrains Mono";
                                                    horizontal-alignment: right;
                                                    vertical-alignment: center;
                                                    x: 6px;
                                                    width: parent.width - 12px;
                                                    height: parent.height;
                                                    accepted => { root.set-rule-playtime-daily(rule.id, self.text); }
                                                    edited => { root.set-rule-playtime-daily(rule.id, self.text); }
                                                }
                                            }
                                            Text {
                                                text: "hrs / day";
                                                color: Theme.text-muted;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Weekly Hours Input (compact width)
                                    if rule.playtime-budget-mode == 1: HorizontalLayout {
                                        cross-axis-alignment: center;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: "Weekly";
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            cross-axis-alignment: center;
                                            Rectangle {
                                                width: 54px;
                                                height: 26px;
                                                border-radius: 5px;
                                                background: Theme.bg;
                                                border-width: 1px;
                                                border-color: Theme.border-strong;

                                                weekly-in := TextInput {
                                                    text: rule.playtime-weekly-hours;
                                                    enabled: root.unlocked && !rule.busy;
                                                    color: Theme.text;
                                                    font-size: 12px;
                                                    font-family: "JetBrains Mono";
                                                    horizontal-alignment: right;
                                                    vertical-alignment: center;
                                                    x: 6px;
                                                    width: parent.width - 12px;
                                                    height: parent.height;
                                                    accepted => { root.set-rule-playtime-weekly(rule.id, self.text); }
                                                    edited => { root.set-rule-playtime-weekly(rule.id, self.text); }
                                                }
                                            }
                                            Text {
                                                text: "hrs / week";
                                                color: Theme.text-muted;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Custom AND-rule Expression Input
                                    if rule.playtime-budget-mode == 2: VerticalLayout {
                                        spacing: 5px;
                                        Rectangle {
                                            height: 28px;
                                            border-radius: 5px;
                                            background: Theme.bg;
                                            border-width: 1px;
                                            border-color: rule.playtime-custom-error ? Theme.red-solid : Theme.border-strong;

                                            custom-in := TextInput {
                                                text: rule.playtime-custom-expr;
                                                enabled: root.unlocked && !rule.busy;
                                                color: Theme.text;
                                                font-size: 11px;
                                                font-family: "JetBrains Mono";
                                                vertical-alignment: center;
                                                x: 8px;
                                                width: parent.width - 16px;
                                                height: parent.height;
                                                accepted => { root.set-rule-playtime-custom(rule.id, self.text); }
                                            }
                                        }
                                        if rule.playtime-custom-summary != "": Text {
                                            text: rule.playtime-custom-summary;
                                            color: rule.playtime-custom-error ? Theme.red-text : Theme.accent-text;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }

                                    // Wait for Match End
                                    Rectangle {
                                        height: 1px;
                                        background: Theme.border;
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        cross-axis-alignment: center;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            Text {
                                                text: rule.first-class ? "Wait for match to end" : "Match-aware cutoff unavailable";
                                                color: rule.first-class ? Theme.text : Theme.text-muted;
                                                font-size: 12px;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: rule.first-class
                                                    ? "✦ " + rule.detector-name + " · delays cutoff until lobby"
                                                    : "No first-class plugin for this title — cuts immediately at 0m";
                                                color: Theme.text-muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }

                                        if rule.first-class && root.unlocked: CurbSwitch {
                                            checked: rule.playtime-wait-match;
                                            enabled: !rule.busy;
                                            toggled => { root.toggle-rule-playtime-wait-match(rule.id); }
                                        }
                                        if rule.first-class && !root.unlocked: ReadOnlyStatusPill {
                                            active: rule.playtime-wait-match;
                                            clicked => { root.require-unlock(); }
                                        }
                                    }

                                    // Per-game Admin Reset
                                    if root.unlocked: Rectangle {
                                        height: 1px;
                                        background: Theme.border;
                                    }
                                    if root.unlocked: HorizontalLayout {
                                        cross-axis-alignment: center;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: rule.playtime-used-label;
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                        Rectangle {
                                            height: 22px;
                                            border-radius: 5px;
                                            background: Theme.accent-soft;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                cross-axis-alignment: center;
                                                Text {
                                                    text: "Reset today’s limit";
                                                    color: Theme.accent-text;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                enabled: !rule.busy;
                                                mouse-cursor: !rule.busy ? pointer : default;
                                                clicked => { root.reset-rule-playtime(rule.id); }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            cross-axis-alignment: center;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: "Allow helper apps";
                                    color: Theme.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "Lets launchers & anti-cheat connect (blocks browsers)";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }

                            if root.unlocked: CurbSwitch {
                                checked: rule.allow-helpers;
                                enabled: !rule.busy;
                                toggled => { root.toggle-rule-helpers(rule.id); }
                            }
                            if !root.unlocked: ReadOnlyStatusPill {
                                active: rule.allow-helpers;
                                clicked => { root.require-unlock(); }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }

                        Rectangle {
                            background: transparent;
                            height: 22px;

                            HorizontalLayout {
                                cross-axis-alignment: center;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Advanced";
                                    color: Theme.text-sec;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: rule.adv-open ? "Hide" : "Show";
                                    color: Theme.text-sec;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.toggle-rule-adv(rule.id); }
                            }
                        }

                        if rule.adv-open: Rectangle {
                            border-radius: 8px;
                            background: Theme.bg;
                            border-width: 1px;
                            border-color: Theme.border-strong;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 10px;

                                // Protocols
                                HorizontalLayout {
                                    cross-axis-alignment: center;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Protocols";
                                        color: Theme.text-sec;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    if root.unlocked: HorizontalLayout {
                                        spacing: 6px;

                                        Rectangle {
                                            height: 24px;
                                            border-radius: 5px;
                                            background: rule.allow-tcp ? Theme.accent : Theme.pill;
                                            opacity: !rule.busy ? 1.0 : 0.55;

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                cross-axis-alignment: center;
                                                Text {
                                                    text: "TCP";
                                                    color: rule.allow-tcp ? #ffffff : Theme.text;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                enabled: !rule.busy;
                                                mouse-cursor: !rule.busy ? pointer : default;
                                                clicked => { root.toggle-rule-tcp(rule.id); }
                                            }
                                        }

                                        Rectangle {
                                            height: 24px;
                                            border-radius: 5px;
                                            background: rule.allow-udp ? Theme.accent : Theme.pill;
                                            opacity: !rule.busy ? 1.0 : 0.55;

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                cross-axis-alignment: center;
                                                Text {
                                                    text: "UDP";
                                                    color: rule.allow-udp ? #ffffff : Theme.text;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                enabled: !rule.busy;
                                                mouse-cursor: !rule.busy ? pointer : default;
                                                clicked => { root.toggle-rule-udp(rule.id); }
                                            }
                                        }
                                    }

                                    if !root.unlocked: HorizontalLayout {
                                        spacing: 6px;

                                        ReadOnlyStatusPill {
                                            active: rule.allow-tcp;
                                            active-label: "TCP";
                                            inactive-label: "TCP off";
                                            clicked => { root.require-unlock(); }
                                        }

                                        ReadOnlyStatusPill {
                                            active: rule.allow-udp;
                                            active-label: "UDP";
                                            inactive-label: "UDP off";
                                            clicked => { root.require-unlock(); }
                                        }
                                    }
                                }

                                // Sub-process scope
                                HorizontalLayout {
                                    spacing: 8px;
                                    cross-axis-alignment: center;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Sub-process scope";
                                        color: Theme.text-sec;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                    if root.unlocked: SubprocessSelector {
                                        current: rule.subprocess-policy;
                                        enabled: !rule.busy;
                                        selected(val) => { root.set-rule-subprocesses(rule.id, val); }
                                    }
                                    if !root.unlocked: ReadOnlyStatusPill {
                                        active: rule.subprocess-policy > 0;
                                        active-label: rule.subprocess-policy == 1 ? "Same signer" : "Any safe";
                                        inactive-label: "Off";
                                        clicked => { root.require-unlock(); }
                                    }
                                }

                                // DNS whitelist
                                VerticalLayout {
                                    spacing: 6px;

                                    HorizontalLayout {
                                        cross-axis-alignment: center;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: "DNS whitelist";
                                            color: Theme.text-sec;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }

                                        if root.unlocked: Rectangle {
                                            background: transparent;
                                            height: 20px;
                                            opacity: !rule.busy ? 1.0 : 0.55;

                                            HorizontalLayout {
                                                padding-left: 4px;
                                                padding-right: 4px;
                                                cross-axis-alignment: center;
                                                Text {
                                                    text: "+ Add";
                                                    color: Theme.accent-text;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            TouchArea {
                                                enabled: !rule.busy;
                                                mouse-cursor: !rule.busy ? pointer : default;
                                                clicked => { root.open-add-domain(rule.id); }
                                            }
                                        }
                                    }

                                    if rule.dns-whitelist.length == 0: Text {
                                        text: "Any destination IP allowed";
                                        color: Theme.text-muted;
                                        font-size: 12px;
                                        font-italic: true;
                                    }

                                    if rule.dns-whitelist.length > 0: FlexboxLayout {
                                        flex-wrap: wrap;
                                        spacing: 6px;

                                        for dom[didx] in rule.dns-whitelist: DomainChip {
                                            domain: dom;
                                            removable: root.unlocked;
                                            enabled: !rule.busy;
                                            removed => { root.remove-rule-domain(rule.id, didx); }
                                        }
                                    }
                                }

                                // Technical metadata
                                Rectangle {
                                    height: 1px;
                                    background: Theme.border;
                                }

                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "File: " + rule.exe-hint;
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        font-family: "JetBrains Mono";
                                        overflow: elide;
                                    }
                                    Text {
                                        text: rule.matcher-detail;
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        font-family: "JetBrains Mono";
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        // Card Footer
                        HorizontalLayout {
                            padding-top: 2px;
                            cross-axis-alignment: center;

                            Text {
                                horizontal-stretch: 1;
                                text: rule.is-steam-game ? "Steam Game" : "App";
                                color: Theme.text-muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            if !root.unlocked: Rectangle {
                                horizontal-stretch: 0;
                                background: transparent;
                                height: 22px;
                                HorizontalLayout {
                                    cross-axis-alignment: center;
                                    Text {
                                        text: "Unlock to edit";
                                        color: Theme.accent-text;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.require-unlock(); }
                                }
                            }

                            if root.unlocked: Rectangle {
                                horizontal-stretch: 0;
                                background: transparent;
                                height: 22px;
                                opacity: !rule.busy ? 1.0 : 0.55;

                                HorizontalLayout {
                                    spacing: 5px;
                                    cross-axis-alignment: center;

                                    if rule.deleting: LoadingDots {
                                        color: Theme.red-text;
                                        dot-size: 3.5px;
                                    }
                                    Text {
                                        text: rule.deleting ? "Removing…" : "Remove";
                                        color: Theme.red-text;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchArea {
                                    enabled: !rule.busy;
                                    mouse-cursor: !rule.busy ? pointer : default;
                                    clicked => { root.delete-rule(rule.id); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
